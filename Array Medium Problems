/* Duplicates in Limited Range Array
Solved
Difficulty: EasyAccuracy: 18.95%Submissions: 940K+Points: 2Average Time: 20m
Given an array arr[] of size n, containing elements from the range 1 to n, and each element appears at most twice, return an array of all the integers that appears twice.

Note: You can return the elements in any order but the driver code will print them in sorted order.

Examples:

Input: arr[] = [2, 3, 1, 2, 3]
Output: [2, 3] 
Explanation: 2 and 3 occur more than once in the given array.*/

Code

class Solution {
    public ArrayList<Integer> findDuplicates(int[] arr) {
       ArrayList<Integer> duplicateArray = new ArrayList<Integer>();
       for(int i=0; i < arr.length; i++){
           int value = Math.abs(arr[i]);
           int index = value - 1;
           if(arr[index] > 0){
               arr[index] = - arr[index];
           }else{
               // Add the vaalue into the duplicate array and return the array. 
               duplicateArray.add(value);
           }
       }
       return duplicateArray;
        
    }
}
/* Given an array arr[] of non-negative integers, move all the zeros to the end of the array while maintaining the relative order of the non-zero elements. Perform the operation in place, without using an extra array.

Examples:

Input: arr[] = [1, 2, 0, 4, 3, 0, 5, 0]
Output: [1, 2, 4, 3, 5, 0, 0, 0]
Explanation: The three zeros are moved to the end while the order of the non-zero elements remains unchanged.*/

class Solution {
    void pushZerosToEnd(int[] arr){
        int index = 0;
        int[] newArray = new int[arr.length];
        for(int i=0; i < arr.length; i++){
            //Segregrate Non-zero elements
            if(arr[i] != 0){
                newArray[index] = arr[i];
                index++;    
            }
            
        }
        //Filled up with remaining zeros. 
        while(index  < arr.length){
            newArray[index] = 0;
            index++;
        }
        for(int i=0; i < newArray.length; i++){
            arr[i] = newArray[i];
        }
    }
}
/*
Given an array of integers arr[], reverse the array in place.

Examples:

Input: arr = [1, 4, 3, 2, 6, 5]
Output: [5, 6, 2, 3, 4, 1]
Explanation: The elements of the array are [1, 4, 3, 2, 6, 5]. After reversing the array, the first element goes to the last position, 
the second element goes to the second last position and so on. Hence, the answer is [5, 6, 2, 3, 4, 1].
*/

class Solution {
    public void reverseArray(int arr[]) {
        // Two pointer Approach
          int left = 0;
          int right = arr.length - 1;
          while(left <= right){
              
              int temp = arr[left];
              arr[left] = arr[right];
              arr[right] = temp;
              
              left++;
              right--;
          }
    }
}
